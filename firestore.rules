rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ignaciiio.mate@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Miembro del equipo: dueño/admin, o usuario aprobado explícitamente por un admin
    // (flag `approved: true` en users/{uid}). Como el registro de cuentas es ABIERTO,
    // un filtro por dominio de correo no alcanza: el acceso a datos de negocio requiere
    // aprobación. Un admin gestiona las aprobaciones desde el panel /administracion.
    function isMember() {
      return isAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true
      );
    }

    // Usuario "supervisado": un admin puede marcar users/{uid}.supervised == true.
    // Sus cotizaciones no pueden pasar directamente a un estado sensible (Enviada/Adjudicada):
    // deben solicitar aprobación (escriben approval.status == 'pending' manteniendo el estado),
    // y un admin aplica el cambio. Los admins no quedan afectados por esta restricción.
    function isSupervised() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('supervised', false) == true;
    }
    function sensitiveEstado(v) {
      return v == 'Enviada' || v == 'Adjudicada';
    }
    // Devolver una cotización desde Backlog al estado que tenía antes no es un ascenso:
    // deshace una clasificación errónea. Mandar algo a Backlog nunca pide aprobación, así
    // que exigirla para revertirlo dejaba atrapadas las cotizaciones mal clasificadas.
    function backlogRestore() {
      return resource != null &&
        resource.data.get('estado', '') == 'Backlog' &&
        resource.data.get('estadoPrevio', '') != '' &&
        request.resource.data.get('estado', '') == resource.data.get('estadoPrevio', '');
    }
    // El cambio queda bloqueado solo si un supervisado intenta llevar el estado a uno
    // sensible distinto del actual (en creación, el estado previo se asume 'Borrador').
    function estadoChangeBlocked() {
      return isSupervised() && !backlogRestore() &&
        sensitiveEstado(request.resource.data.get('estado', 'Borrador')) &&
        request.resource.data.get('estado', 'Borrador') !=
          (resource != null ? resource.data.get('estado', 'Borrador') : 'Borrador');
    }
    // Un supervisado no puede eliminar: ni borrado real ni soft-delete (deleted true).
    function deleteBlocked() {
      return isSupervised() &&
        request.resource.data.get('deleted', false) == true &&
        (resource == null || resource.data.get('deleted', false) != true);
    }
    // Un supervisado solo ve y gestiona lo suyo (createdBy == su uid).
    function ownsDoc() {
      return resource != null && resource.data.get('createdBy', '') == request.auth.uid;
    }
    match /quotes/{id} {
      allow read:   if isMember() && (isAdmin() || !isSupervised() || ownsDoc());
      allow create: if isMember() && (isAdmin() || !estadoChangeBlocked());
      allow update: if isMember() && (isAdmin() || (!estadoChangeBlocked() && !deleteBlocked()));
      allow delete: if isMember() && (isAdmin() || !isSupervised());
    }
    match /clients/{id} {
      allow read:   if isMember() && (isAdmin() || !isSupervised() || ownsDoc());
      allow create: if isMember();
      allow update: if isMember() && (isAdmin() || !deleteBlocked());
      allow delete: if isMember() && (isAdmin() || !isSupervised());
    }
    match /templates/{id} {
      allow read, write: if isMember();
    }
    match /users/{uid} {
      // Cada usuario lee su propio perfil; los miembros del equipo ven el roster (chat, ranking)
      allow read: if request.auth != null && (request.auth.uid == uid || isMember());
      allow write: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      match /fcmTokens/{token} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Logs de actividad: cada usuario escribe solo los suyos; todos los autenticados leen (feed de equipo)
    match /activityLogs/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read:   if request.auth != null;
    }

    // Sesiones: cada usuario escribe la suya; solo admin lee
    match /sessions/{id} {
      allow create, update: if request.auth != null &&
        (resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
    }

    // Broadcasts: solo admin crea/lee/elimina; la Cloud Function actualiza con Admin SDK
    match /adminBroadcasts/{id} {
      allow create, read, delete: if isAdmin();
    }

    // Recordatorios (bloc de notas del admin)
    match /adminNotes/{id} {
      allow read, write: if isAdmin();
    }

    // Plantillas reutilizables de notificaciones push (panel admin)
    match /notifTemplates/{id} {
      allow read, write: if isAdmin();
    }

    // Academia: agenda de reuniones y clases del equipo (la Cloud Function actualiza
    // los flags de aviso con Admin SDK, fuera de estas reglas)
    match /academiaEventos/{id} {
      allow read, write: if isMember();
    }

    // Chat del equipo: miembros leen; cada uno crea/edita/borra solo lo suyo; admin borra cualquiera
    match /chatMensajes/{id} {
      allow read:   if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    // Chat de administradores: solo admins leen/escriben; edita/borra el autor (o admin)
    match /chatMensajesAdmin/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isAdmin();
    }

    // Presencia "escribiendo…": efímera, cada uno escribe/borra solo la suya
    match /chatTyping/{id} {
      allow read:           if isMember();
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete:         if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Acuses de lectura del chat: cada uno escribe el suyo; los miembros los leen
    match /chatReads/{id} {
      allow read:           if isMember();
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
    }

    // Tareas asignadas: el admin las crea/edita/borra; el asignado las lee y solo puede
    // marcarlas como completada (cambiar estado/completedAt), nada más.
    match /tareas/{id} {
      allow read:           if isAdmin() || (request.auth != null && resource.data.asignadoA == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.asignadoA == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'completedAt'])
      );
    }

    // Propuestas de mejora (tablero de marcha blanca): los miembros leen, crean y votan;
    // el moderador (admin) cambia el estado. El autor o un admin pueden eliminar.
    match /propuestas/{id} {
      allow read:   if isMember();
      allow create: if isMember() && request.resource.data.autorUid == request.auth.uid;
      allow update: if isAdmin() || (
        isMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votos'])
      );
      allow delete: if isAdmin() || (isMember() && resource.data.autorUid == request.auth.uid);
    }

    // Configuración global (versión de app, etc.)
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Historial global de notificaciones (escrito por Cloud Functions con
    // Admin SDK). Cualquier usuario autenticado puede leer su feed; el estado
    // "leído / limpiado" se guarda por usuario en /users/{uid} como
    // lastNotifReadAt y lastNotifClearAt, así no se necesitan writes per-user.
    match /notifications/{id} {
      allow read: if request.auth != null;
      // create/update/delete bloqueado al cliente: solo Admin SDK.
    }
  }
}

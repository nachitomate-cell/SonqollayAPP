rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cotizaciones y clientes: compartidos entre todos los usuarios autenticados
    match /quotes/{id} {
      allow read, write: if request.auth != null;
    }
    match /clients/{id} {
      allow read, write: if request.auth != null;
    }

    // Perfil y tokens FCM: cada usuario solo accede a los suyos
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /quotes/{id} {
      allow read, write: if request.auth != null;
    }
    match /clients/{id} {
      allow read, write: if request.auth != null;
    }
    match /templates/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Logs de actividad: cada usuario escribe solo los suyos; solo admin lee
    match /activityLogs/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
    }

    // Sesiones: cada usuario escribe la suya; solo admin lee
    match /sessions/{id} {
      allow create, update: if request.auth != null &&
        (resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
    }

    // Broadcasts: solo admin crea/lee/elimina; la Cloud Function actualiza con Admin SDK
    match /adminBroadcasts/{id} {
      allow create, read, delete: if isAdmin();
    }

    // Recordatorios (bloc de notas del admin)
    match /adminNotes/{id} {
      allow read, write: if isAdmin();
    }
  }
}
